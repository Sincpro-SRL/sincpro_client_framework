{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "paths": {
      "@sincpro/client-framework": ["./src/index.ts"],
      "@sincpro/client-framework/opentelemetry": [
        "./src/observability/adapters/opentelemetry.ts"
      ],
      "@sincpro/client-framework/console": ["./src/observability/adapters/console.ts"],
      "@sincpro/client-framework/sentry": ["./src/observability/adapters/sentry.ts"],
      "@sincpro/client-framework/parquet": ["./src/client/adapters/parquet.ts"],
      "@sincpro/client-framework/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
